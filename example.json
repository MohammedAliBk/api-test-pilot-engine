{
  "api": {
    "base_url": "https://httpbingo.org"
  },
  "test_cases": [
    {
      "id": "GET001",
      "description": "GET response body and content type",
      "request": {
        "method": "GET",
        "path": "/json"
      },
      "expected": {
        "status_code": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "slideshow": {
            "author": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "max_duration_ms": 3000
      }
    },
    {
      "id": "GET002",
      "description": "Query parameter is reflected",
      "request": {
        "method": "GET",
        "path": "/get",
        "query": {
          "project": "api-test-pilot"
        }
      },
      "expected": {
        "status_code": 200,
        "body": {
          "args": {
            "project": ["api-test-pilot"]
          }
        }
      }
    },
    {
      "id": "POST001",
      "description": "POST JSON body is reflected",
      "request": {
        "method": "POST",
        "path": "/post",
        "headers": {
          "Content-Type": "application/json"
        },
        "json": {
          "name": "API Test Pilot",
          "version": 1
        }
      },
      "expected": {
        "status_code": 200,
        "body": {
          "json": {
            "name": "API Test Pilot",
            "version": 1
          }
        }
      }
    }
  ]
}
